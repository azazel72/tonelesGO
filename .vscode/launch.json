{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug servidor 5001",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "servidor.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "5001"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
